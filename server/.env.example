# ---- Runtime ----
NODE_ENV=development
PORT=5000

# ---- Database ----
# Local MongoDB:
MONGODB_URI=mongodb://127.0.0.1:27017/hms
# MongoDB Atlas example:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/hms?retryWrites=true&w=majority

# ---- Auth ----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# MUST be different from each other. MUST be changed before deploying.
JWT_ACCESS_SECRET=replace-me-with-a-long-random-string-at-least-32-chars
JWT_REFRESH_SECRET=replace-me-with-a-DIFFERENT-long-random-string-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cookie settings
COOKIE_DOMAIN=
# Set true only when serving over HTTPS
COOKIE_SECURE=false

# ---- CORS ----
# Comma-separated list of allowed browser origins (the React dev server)
CLIENT_ORIGIN=http://localhost:5173

# ---- File storage ----
# Where generated patient documents (lab reports, later radiology/invoices) are
# written. Relative paths resolve against the server/ directory.
# NOT served statically — downloads go through authenticated routes only.
UPLOADS_DIR=uploads

# ---- Hospital identity (printed on report letterheads) ----
HOSPITAL_NAME=General Hospital
HOSPITAL_ADDRESS=1 Hospital Road, Central District, City
HOSPITAL_PHONE=+1 555 000 1234
HOSPITAL_EMAIL=lab@hospital.local

# ---- Seed (npm run seed) ----
SEED_ADMIN_EMAIL=admin@hospital.local
SEED_ADMIN_PASSWORD=Admin@12345
SEED_ADMIN_FIRST_NAME=System
SEED_ADMIN_LAST_NAME=Administrator
