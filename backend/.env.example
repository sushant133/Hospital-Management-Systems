# ---- Runtime ----
NODE_ENV=development
PORT=5050

# ---- Database ----
# Local MongoDB:
MONGODB_URI=mongodb://127.0.0.1:27017/hms
# MongoDB Atlas example:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/hms?retryWrites=true&w=majority

# ---- Auth ----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# MUST be different from each other. MUST be changed before deploying.
JWT_ACCESS_SECRET=replace-me-with-a-long-random-string-at-least-32-chars
JWT_REFRESH_SECRET=replace-me-with-a-DIFFERENT-long-random-string-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cookie settings
COOKIE_DOMAIN=
# Set true only when serving over HTTPS
COOKIE_SECURE=false

# ---- CORS ----
# Comma-separated list of allowed browser origins (the React dev server)
CLIENT_ORIGIN=http://localhost:5180,http://127.0.0.1:5180

# ---- File storage ----
# Where generated patient documents (lab reports, later radiology/invoices) are
# written. Relative paths resolve against the backend/ directory.
# NOT served statically — downloads go through authenticated routes only.
UPLOADS_DIR=uploads

# ---- Hospital identity (printed on report letterheads) ----
HOSPITAL_NAME=General Hospital
HOSPITAL_ADDRESS=1 Hospital Road, Central District, City
HOSPITAL_PHONE=+1 555 000 1234
HOSPITAL_EMAIL=lab@hospital.local

# ---- Abuse controls (auth) ----
# Consecutive failed passwords against a known account before lockout.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
# IP-level cap on POST /auth/login (covers stuffing unknown emails).
LOGIN_RATE_MAX=20
LOGIN_RATE_WINDOW_MS=900000

# ---- Audit ----
# Off by default. Set true to write a `view` row for each PHI chart/order open.
AUDIT_READS=false

# ---- Nightly jobs ----
# In-process scheduler (disable on every replica except one, or when using cron).
JOBS_ENABLED=true
# Local hour (0-23) the in-process runner fires. 2 = 02:00.
JOBS_HOUR=2
# One-shot from cron: npm run jobs

# ---- Notifications ----
# Optional HTTP endpoint a hospital points at SMS / Slack / a pager gateway.
NOTIFY_WEBHOOK_URL=

# ---- Billing ----
# Default GST/VAT percent applied when a charge does not set its own.
HOSPITAL_TAX_PERCENT=0

# ---- Seed (npm run seed) ----
SEED_ADMIN_EMAIL=admin@hospital.local
SEED_ADMIN_PASSWORD=Admin@12345
SEED_ADMIN_FIRST_NAME=System
SEED_ADMIN_LAST_NAME=Administrator

# ============================================================================
# NEPAL LOCALISATION (Tier A)
# ============================================================================
# Every figure marked ⚠ is set by statute, directive or annual budget and MOVES.
# Confirm each against the operative circular before the system goes live, and
# re-confirm at the start of each fiscal year (Shrawan 1).

# --- Locale ---------------------------------------------------------------
# Nepali is the default; staff who prefer English switch it per-account.
DEFAULT_LOCALE=en

# Devanagari PDF rendering (A2).
# PDFKit's built-in fonts contain NO Devanagari glyphs — without a real font
# file, Nepali invoices and payslips print as empty boxes. Drop a TTF into
# backend/assets/fonts/ (Noto Sans Devanagari, SIL OFL, is recommended and
# redistributable) or point this at one. Mangal ships with Windows but is NOT
# licensed for redistribution with an application.
DEVANAGARI_FONT_PATH=

# --- Hospital identity (printed on every bill and report) -----------------
HOSPITAL_NAME=General Hospital
HOSPITAL_NAME_NE=
HOSPITAL_ADDRESS=
HOSPITAL_ADDRESS_NE=
HOSPITAL_PHONE=
HOSPITAL_EMAIL=
# District code from shared/nepal/administrative.js, e.g. P3-D05 for Kathmandu.
HOSPITAL_DISTRICT_CODE=
# primary | district | provincial | central — sets Aama Surakshya package rates
# and this facility's position in the referral chain.
HOSPITAL_LEVEL=district

# --- A8: IRD / tax compliance --------------------------------------------
# ⚠ Most hospital SERVICES are VAT-exempt; pharmacy retail, cafeteria and
# third-party diagnostics may not be. Taxability is set per charge line
# (Invoice.TAX_CATEGORIES) — this rate applies only to lines marked `taxable`.
# Confirm the classification of your own service catalogue with your auditor.
IRD_VAT_PERCENT=13
HOSPITAL_PAN=
HOSPITAL_VAT_REGISTERED=false

# CBMS real-time invoice sync. Leave off until the hospital is registered with
# IRD; invoices still print and queue for sync when it is enabled later.
CBMS_ENABLED=false
CBMS_URL=
CBMS_USERNAME=
CBMS_PASSWORD=
CBMS_SELLER_PAN=
CBMS_MAX_ATTEMPTS=10

# --- A11: SMS -------------------------------------------------------------
# sparrow | aakash | webhook
SMS_ENABLED=false
SMS_PROVIDER=sparrow
SMS_BASE_URL=https://api.sparrowsms.com/v2/sms/
SMS_TOKEN=
SMS_SENDER_ID=
# A Devanagari message is UCS-2, so a segment is 70 characters not 160 —
# a Nepali reminder costs roughly 3x an English one. Ask your provider.
SMS_COST_PER_SEGMENT=1
SMS_MAX_ATTEMPTS=3

# --- A10: Domestic payment gateways --------------------------------------
GATEWAY_RETURN_URL=http://localhost:5180/billing/payment-result

ESEWA_ENABLED=false
ESEWA_MERCHANT_CODE=
ESEWA_SECRET=
ESEWA_BASE_URL=https://rc-epay.esewa.com.np

KHALTI_ENABLED=false
KHALTI_SECRET_KEY=
KHALTI_BASE_URL=https://a.khalti.com/api/v2

FONEPAY_ENABLED=false
FONEPAY_MERCHANT_CODE=
FONEPAY_SECRET=
FONEPAY_BASE_URL=

CONNECTIPS_ENABLED=false
CONNECTIPS_MERCHANT_ID=
CONNECTIPS_APP_ID=
CONNECTIPS_APP_NAME=
CONNECTIPS_PASSWORD=
CONNECTIPS_BASE_URL=

# --- A9: HMIS / DHIS2 statutory reporting --------------------------------
HMIS_ENABLED=false
DHIS2_URL=
DHIS2_USERNAME=
DHIS2_PASSWORD=
# This facility's code in the national Health Facility Registry.
HMIS_FACILITY_CODE=
# The DHIS2 organisation unit this facility reports as. Indicators must also be
# mapped to DHIS2 data elements during commissioning — unmapped indicators are
# reported to the operator rather than silently omitted from a submission.
DHIS2_ORG_UNIT_ID=

# --- A6/A7: Insurance and government schemes ------------------------------
# HIB household ceilings, scheme ceilings and incentive amounts are seeded into
# the DATABASE (see src/data/nepalSchemes.js), not set here, so the accounts
# office can correct them without a code release. ⚠ Verify every seeded figure.

# --- A14: Payroll ---------------------------------------------------------
# SSF rates, tax bands, festival expense and leave entitlements live in
# src/config/nepalPayroll.js. ⚠ CONFIRM THE TAX BANDS AGAINST THE CURRENT
# FINANCE ACT BEFORE THE FIRST PAYROLL RUN OF EACH FISCAL YEAR.
