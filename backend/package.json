{
  "name": "hms-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Hospital Management System — API server",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "seed": "node scripts/seed.js",
    "migrate": "node scripts/migrate.js",
    "jobs": "node scripts/run-jobs.js",
    "lint": "eslint src scripts",
    "test": "node --test tests/unit/*.test.js tests/integration/*.test.js",
    "backup": "node scripts/backup.js create",
    "backup:list": "node scripts/backup.js list",
    "backup:verify": "node scripts/backup.js verify",
    "terminology": "node scripts/importTerminology.js",
    "local-levels": "node scripts/importLocalLevels.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "morgan": "^1.10.0",
    "multer": "^2.2.0",
    "pdfkit": "^0.19.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "eslint": "^8.57.1"
  }
}
